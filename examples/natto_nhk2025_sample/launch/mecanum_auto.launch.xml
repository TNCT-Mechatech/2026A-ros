<launch>
    <!-- Auto operation, monitoring and mechanisms share this entry point. -->
    <arg name="launch_inject" default="true" description="Start both inject and roll nodes via inject2026A"/>
    <arg name="inject_serial_config" default="$(find-pkg-share inject2026A)/config/serial_ports.yaml"/>
    <arg name="inject_joy_topic" default="/inject/joy"/>
    <arg name="launch_system_monitor" default="true"/>
    <arg name="record" default="false"/>
    <arg name="rosgraph" default="true"/>
    <arg name="publish_pursuit_debug" default="false"/>
    <arg name="monitor_inject" default="$(var launch_inject)"/>
    <arg name="monitor_roll" default="$(var launch_inject)"/>
    <arg name="monitor_mecanum" default="true"/>
    <arg name="monitor_config" default="$(find-pkg-share natto_system_monitor)/config/monitor.yaml"/>
    <arg name="record_config" default="$(find-pkg-share natto_system_monitor)/config/recording.yaml"/>
    <arg name="bag_directory" default="$(env HOME)/rosbags"/>
    <arg name="bag_name" default=""/>
    <arg name="gain_config_path" default="" description="PID YAML path; empty uses ROS_HOME/natto/pid_gain.yaml (default: ~/.ros/natto/pid_gain.yaml)"/>
    <arg name="navigation_mode" default="buttons"/>
    <arg name="destinations_path" default="$(find-pkg-share natto_nhk2025_sample)/config/destinations.yaml"/>
    <arg name="goal_buttons_path" default="$(find-pkg-share natto_nhk2025_sample)/config/goal_buttons_common.yaml"/>
    <arg name="serial_path" default="/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_066EFF565653756687235135-if02"/>
    <arg name="launch_behavior" default="true"/>
    <arg name="launch_sensing" default="true"/>
    <arg name="launch_localization" default="true"/>
    <arg name="launch_visualization" default="false"/>
    <arg name="launch_lakibeam" default="true"/>
    <arg name="launch_dynamic_auto_control" default="true"/>
    <arg name="launch_static_auto_control" default="false"/>
    <arg name="speed_path_directory" default=""/>
    <arg name="controller_max_xy_speed_m_s" default="0.3"/>
    <arg name="controller_max_yaw_speed_rad_s" default="1.0"/>
    <arg name="lakibeam_hostip" default="0.0.0.0"/>
    <arg name="lakibeam_port_front" default="2368"/>
    <arg name="lakibeam_port_rear" default="2369"/>
    <arg name="lakibeam_sensorip_front" default=""/>
    <arg name="lakibeam_sensorip_rear" default=""/>
    <arg name="lakibeam_inverted_front" default="false"/>
    <arg name="lakibeam_inverted_rear" default="false"/>
    <arg name="lakibeam_angle_offset_front" default="0"/>
    <arg name="lakibeam_angle_offset_rear" default="0"/>
    <arg name="lakibeam_scanfreq" default="30"/>
    <arg name="lakibeam_filter" default="3"/>
    <arg name="lakibeam_laser_enable" default="true"/>
    <arg name="lakibeam_scan_range_start" default="45"/>
    <arg name="lakibeam_scan_range_stop" default="315"/>

    <include file="$(find-pkg-share lakibeam1)/launch/lakibeam1_scan_dual_lidar.launch.py" if="$(var launch_lakibeam)">
        <arg name="frame_id0" value="lidar_front"/>
        <arg name="frame_id1" value="lidar_rear"/>
        <arg name="output_topic0" value="/sensing/lidar/laserscan/front"/>
        <arg name="output_topic1" value="/sensing/lidar/laserscan/rear"/>
        <arg name="hostip" value="$(var lakibeam_hostip)"/>
        <arg name="port0" value="$(var lakibeam_port_front)"/>
        <arg name="port1" value="$(var lakibeam_port_rear)"/>
        <arg name="sensorip0" value="$(var lakibeam_sensorip_front)"/>
        <arg name="sensorip1" value="$(var lakibeam_sensorip_rear)"/>
        <arg name="inverted0" value="$(var lakibeam_inverted_front)"/>
        <arg name="inverted1" value="$(var lakibeam_inverted_rear)"/>
        <arg name="angle_offset0" value="$(var lakibeam_angle_offset_front)"/>
        <arg name="angle_offset1" value="$(var lakibeam_angle_offset_rear)"/>
        <arg name="scanfreq" value="$(var lakibeam_scanfreq)"/>
        <arg name="filter" value="$(var lakibeam_filter)"/>
        <arg name="laser_enable" value="$(var lakibeam_laser_enable)"/>
        <arg name="scan_range_start" value="$(var lakibeam_scan_range_start)"/>
        <arg name="scan_range_stop" value="$(var lakibeam_scan_range_stop)"/>
    </include>

    <include file="$(find-pkg-share natto_launch)/launch/natto.launch.xml">
        <arg name="launch_system_monitor" value="$(var launch_system_monitor)"/>
        <arg name="record" value="$(var record)"/>
        <arg name="rosgraph" value="$(var rosgraph)"/>
        <arg name="publish_pursuit_debug" value="$(var publish_pursuit_debug)"/>
        <arg name="monitor_inject" value="$(var monitor_inject)"/>
        <arg name="monitor_roll" value="$(var monitor_roll)"/>
        <arg name="monitor_mecanum" value="$(var monitor_mecanum)"/>
        <arg name="monitor_config" value="$(var monitor_config)"/>
        <arg name="record_config" value="$(var record_config)"/>
        <arg name="bag_directory" value="$(var bag_directory)"/>
        <arg name="bag_name" value="$(var bag_name)"/>
        <arg name="launch_inject" value="$(var launch_inject)"/>
        <arg name="inject_serial_config" value="$(var inject_serial_config)"/>
        <arg name="inject_joy_topic" value="$(var inject_joy_topic)"/>
        <arg name="monitor_mecanum_device" value="$(var serial_path)"/>
        <arg name="navigation_mode" value="$(var navigation_mode)"/>
        <arg name="destinations_path" value="$(var destinations_path)"/>
        <arg name="goal_buttons_path" value="$(var goal_buttons_path)"/>
        <arg name="chassis_type" value="mecanum"/>
        <arg name="chassis_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/chassis/mecanum.yaml"/>
        <arg name="urdf_path" value="$(find-pkg-share natto_nhk2025_sample)/urdf/mecanum_sample.urdf.xacro"/>
        <arg name="line_segments_path" value="$(find-pkg-share natto_nhk2025_sample)/config/map/line_segments.csv"/>
        <arg name="circles_path" value="$(find-pkg-share natto_nhk2025_sample)/config/map/circles.csv"/>
        <arg name="footprint_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/footprint.yaml"/>
        <arg name="lidar_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/lidar.yaml"/>
        <arg name="control_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/control.yaml"/>
        <arg name="planning_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/planning.yaml"/>
        <arg name="restricted_zones_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/map/restricted_zones.yaml"/>
        <arg name="localization_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/localization.yaml"/>
        <arg name="controller_param_path" value="$(find-pkg-share natto_nhk2025_sample)/config/controller.yaml"/>
        <arg name="state_graph_path" value="$(find-pkg-share natto_nhk2025_sample)/state_graph/sample.md"/>
        <arg name="joint_rule_path" value="$(find-pkg-share natto_nhk2025_sample)/config/joint_rule.yaml"/>
        <arg name="launch_simulation" value="false"/>
        <arg name="launch_behavior" value="$(var launch_behavior)"/>
        <arg name="launch_sensing" value="$(var launch_sensing)"/>
        <arg name="lidar_merge_mode" value="passthrough"/>
        <arg name="launch_localization" value="$(var launch_localization)"/>
        <arg name="launch_visualization" value="$(var launch_visualization)"/>
        <arg name="launch_dynamic_auto_control" value="$(var launch_dynamic_auto_control)"/>
        <arg name="launch_static_auto_control" value="$(var launch_static_auto_control)"/>
        <arg name="speed_path_directory" value="$(var speed_path_directory)"/>
        <arg name="initial_allow_auto_drive" value="false"/>
        <arg name="controller_max_xy_speed_m_s" value="$(var controller_max_xy_speed_m_s)"/>
        <arg name="controller_max_yaw_speed_rad_s" value="$(var controller_max_yaw_speed_rad_s)"/>
    </include>

    <node
      pkg="natto_robot_hardware"
      exec="serial_motor_bridge"
      name="serial_motor_bridge"
      output="screen">
      <param from="$(find-pkg-share natto_robot_hardware)/config/serial_motor_bridge.yaml"/>
      <param name="serial_path" value="$(var serial_path)"/>
      <param name="gain_config_path" value="$(var gain_config_path)" type="str"/>
    </node>
</launch>
