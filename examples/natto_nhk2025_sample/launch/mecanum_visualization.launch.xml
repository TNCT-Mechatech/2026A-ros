<launch>
    <arg name="fps" default="15.0"/>
    <arg name="use_dark_rviz" default="true"/>
    <arg name="launch_rviz" default="true"/>
    <arg name="rviz_path" default="$(find-pkg-share natto_launch)/rviz/sample.rviz"/>

    <include file="$(find-pkg-share natto_launch)/launch/components/visualization.launch.xml">
        <arg name="fps" value="$(var fps)"/>
        <arg name="use_dark_rviz" value="$(var use_dark_rviz)"/>
        <arg name="launch_rviz" value="$(var launch_rviz)"/>
        <arg name="rviz_path" value="$(var rviz_path)"/>
    </include>
</launch>
