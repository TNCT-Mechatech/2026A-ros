<launch>
    <!-- Passive monitoring is opt-in to preserve existing launch behavior. -->
    <arg name="launch_system_monitor" default="false"/>
    <arg name="record" default="false"/>
    <arg name="rosgraph" default="true"/>
    <arg name="publish_pursuit_debug" default="false"/>
    <arg name="monitor_inject" default="false"/>
    <arg name="monitor_roll" default="false"/>
    <arg name="monitor_mecanum" default="false"/>
    <arg name="monitor_config" default="$(find-pkg-share natto_system_monitor)/config/monitor.yaml"/>
    <arg name="record_config" default="$(find-pkg-share natto_system_monitor)/config/recording.yaml"/>
    <arg name="bag_directory" default="$(env HOME)/rosbags"/>
    <arg name="bag_name" default=""/>
    <arg name="gain_config_path" default="" description="PID YAML path; empty uses ROS_HOME/natto/pid_gain.yaml (default: ~/.ros/natto/pid_gain.yaml)"/>
    <arg name="serial_path" default="/dev/serial/by-id/usb-STMicroelectronics_STM32_STLink_066EFF565653756687235135-if02"/>
    <arg name="open_loop_full_scale_rps" default="4.0"/>
    <arg name="open_loop_output_limit" default="0.2"/>
    <arg name="open_loop_slew_rate_per_sec" default="1.0"/>

    <!--
      エンコーダ故障時の手動退避専用。
      通常の自動制御launchはclosed_loop_velocity/pid=trueのまま変更しません。
    -->
    <include file="$(find-pkg-share natto_nhk2025_sample)/launch/mecanum_real.launch.xml">
        <arg name="serial_path" value="$(var serial_path)"/>
        <arg name="gain_config_path" value="$(var gain_config_path)"/>
        <arg name="launch_behavior" value="false"/>
        <arg name="launch_sensing" value="false"/>
        <arg name="launch_localization" value="false"/>
        <arg name="launch_visualization" value="false"/>
        <arg name="publish_map" value="false"/>
        <arg name="launch_dynamic_auto_control" value="false"/>
        <arg name="launch_static_auto_control" value="false"/>
        <arg name="motor_command_mode" value="open_loop_normalized"/>
        <arg name="motor_pid" value="false"/>
        <arg name="open_loop_full_scale_rps" value="$(var open_loop_full_scale_rps)"/>
        <arg name="open_loop_output_limit" value="$(var open_loop_output_limit)"/>
        <arg name="open_loop_slew_rate_per_sec" value="$(var open_loop_slew_rate_per_sec)"/>
    </include>
</launch>
