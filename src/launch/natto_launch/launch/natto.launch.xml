<launch>
    <!-- Generic launch keeps opt-in defaults; auto entry points enable these. -->
    <arg name="launch_inject" default="false" description="Start both inject and roll nodes via inject2026A"/>
    <arg name="inject_serial_config" default="$(find-pkg-share inject2026A)/config/serial_ports.yaml"/>
    <arg name="inject_auto_restart" default="false"/>
    <arg name="inject_joy_topic" default="/inject/joy"/>
    <arg name="monitor_mecanum_device" default=""/>
    <arg name="launch_system_monitor" default="false"/>
    <arg name="record" default="false"/>
    <arg name="rosgraph" default="true"/>
    <arg name="publish_pursuit_debug" default="false"/>
    <arg name="monitor_inject" default="$(var launch_inject)"/>
    <arg name="monitor_roll" default="$(var launch_inject)"/>
    <arg name="monitor_mecanum" default="false"/>
    <arg name="monitor_config" default="$(find-pkg-share natto_system_monitor)/config/monitor.yaml"/>
    <arg name="record_config" default="$(find-pkg-share natto_system_monitor)/config/recording.yaml"/>
    <arg name="bag_directory" default="$(env HOME)/rosbags"/>
    <arg name="bag_name" default=""/>
    <arg name="navigation_mode" default="sequence"/>
    <arg name="destinations_path" default=""/>
    <arg name="goal_buttons_path" default=""/>
    <let name="managed_navigation" value="$(eval &quot;'$(var navigation_mode)' == 'buttons'&quot;)"/>
    <arg name="chassis_type" default="swerve"/>
    <arg name="use_odom_tf" default="false"/>
    <arg name="use_laserscan_convert" default="true"/>
    <arg name="use_ransac" default="true"/>
    <arg name="occupancy_grid_resolution" default="0.05"/>
    <arg name="merged_lidar_publish_frequency" default="40.0"/>
    <arg name="lidar_merge_mode" default="merge"/>
    <arg name="lidar_timeout_seconds" default="0.2"/>
    <arg name="publish_map" default="true"/>
    <arg name="initial_allow_auto_drive" default="false"/>
    <arg name="state_timeout_sec" default="3.0"/>
    <arg name="fps" default="30.0"/>
    <arg name="use_dark_rviz" default="true"/>
    <arg name="controller_max_xy_speed_m_s" default="4.0"/>
    <arg name="controller_max_yaw_speed_rad_s" default="4.0"/>
    <arg name="reverse_y" default="false"/>
    <arg name="reverse_y_offset" default="0.0"/>

    <arg name="urdf_path" default=""/>
    <arg name="chassis_param_path" default=""/>
    <arg name="line_segments_path" default=""/>
    <arg name="circles_path" default=""/>
    <arg name="footprint_param_path" default=""/>
    <arg name="lidar_param_path" default=""/>
    <arg name="localization_param_path" default=""/>
    <arg name="planning_param_path" default=""/>
    <arg name="restricted_zones_param_path"/>
    <arg name="control_param_path" default=""/>
    <arg name="controller_param_path" default=""/>
    <arg name="simulation_param_path" default=""/>
    <arg name="state_graph_path" default=""/>
    <arg name="joint_rule_path" default=""/>
    <arg name="speed_path_directory" default=""/>
    <arg name="rviz_path" default="$(find-pkg-share natto_launch)/rviz/sample.rviz"/>

    <arg name="launch_behavior" default="true"/>
    <arg name="launch_common" default="true"/>
    <arg name="launch_simulation" default="true"/>
    <arg name="launch_sensing" default="true"/>
    <arg name="launch_localization" default="true"/>
    <arg name="launch_control" default="true"/>
    <arg name="launch_dynamic_auto_control" default="true"/>
    <arg name="launch_static_auto_control" default="false"/>
    <arg name="launch_visualization" default="true"/>

    <arg name="joint_state_topics" default="['/$(var chassis_type)/command_joint_states', '/controller/joint_states', '/behavior/command_joint_states']"/>

    <include file="$(find-pkg-share natto_launch)/launch/components/navigation.launch.py"/>

    <!-- 行動管理 -->
    <include file="$(find-pkg-share natto_launch)/launch/components/behavior.launch.xml" if="$(eval &quot;'$(var launch_behavior)'.lower() == 'true' and '$(var navigation_mode)' == 'sequence'&quot;)"/>

    <!-- コモン -->
    <include file="$(find-pkg-share natto_launch)/launch/components/common.launch.xml" if="$(var launch_common)"/>

    <!-- シミュレーション -->
    <include file="$(find-pkg-share natto_launch)/launch/components/simulation.launch.xml" if="$(var launch_simulation)"/>

    <!-- センシング -->
    <include file="$(find-pkg-share natto_launch)/launch/components/sensing.launch.xml" if="$(var launch_sensing)">
        <arg name="lidar_merge_mode" value="$(var lidar_merge_mode)"/>
        <arg name="lidar_timeout_seconds" value="$(var lidar_timeout_seconds)"/>
    </include>

    <!-- 自己位置 -->
    <include file="$(find-pkg-share natto_launch)/launch/components/localization.launch.xml" if="$(var launch_localization)"/>

    <!-- コントロール -->
    <include file="$(find-pkg-share natto_launch)/launch/components/control.launch.xml" if="$(var launch_control)"/>

    <!-- 表示 -->
    <include file="$(find-pkg-share natto_launch)/launch/components/visualization.launch.xml" if="$(var launch_visualization)"/>

    <!-- inject2026A/main owns both mechanism nodes; start it only once. -->
    <include file="$(find-pkg-share inject2026A)/launch/inject.launch.xml" if="$(var launch_inject)">
        <arg name="serial_config" value="$(var inject_serial_config)"/>
        <arg name="joy_topic" value="$(var inject_joy_topic)"/>
        <arg name="auto_restart" value="$(var inject_auto_restart)"/>
    </include>

    <include file="$(find-pkg-share natto_system_monitor)/launch/monitor.launch.py" if="$(eval &quot;'$(var launch_system_monitor)'.lower() == 'true' or '$(var record)'.lower() == 'true'&quot;)">
        <arg name="monitor" value="$(var launch_system_monitor)"/>
        <arg name="record" value="$(var record)"/>
        <arg name="rosgraph" value="$(var rosgraph)"/>
        <arg name="managed_navigation" value="$(var managed_navigation)"/>
        <arg name="monitor_lidar" value="$(var launch_sensing)"/>
        <arg name="monitor_localization" value="$(var launch_localization)"/>
        <arg name="monitor_navigation" value="$(eval &quot;'$(var launch_control)'.lower() == 'true' and '$(var launch_dynamic_auto_control)'.lower() == 'true'&quot;)"/>
        <arg name="monitor_inject" value="$(var monitor_inject)"/>
        <arg name="monitor_roll" value="$(var monitor_roll)"/>
        <arg name="monitor_mecanum" value="$(var monitor_mecanum)"/>
        <arg name="monitor_config" value="$(var monitor_config)"/>
        <arg name="serial_ports_config" value="$(eval &quot;'$(var inject_serial_config)' if '$(var launch_inject)'.lower() == 'true' else ''&quot;)"/>
        <arg name="mecanum_device" value="$(var monitor_mecanum_device)"/>
        <arg name="record_config" value="$(var record_config)"/>
        <arg name="bag_directory" value="$(var bag_directory)"/>
        <arg name="bag_name" value="$(var bag_name)"/>
    </include>
</launch>
