<launch>
  <arg name="auto_restart" default="false"/>
  <arg name="inject_pid" default="true" description="Rack position PID; false selects encoder-independent Duty control"/>
  <arg name="rack_angle_profile" default="true" description="Buttons 4/5 move to configured rack angles with a trapezoidal profile"/>
  <arg name="rack_target_angle_4_deg" default="" description="Button 4 angle; empty uses serial_config"/>
  <arg name="rack_target_angle_5_deg" default="" description="Button 5 angle; empty uses serial_config"/>
  <arg name="rack_angle_count_sign" default="" description="Raw count direction away from origin: +1 or -1; empty uses serial_config"/>
  <arg name="serial_config" default="$(find-pkg-share inject2026A)/config/serial_ports.yaml"/>
  <arg name="joy_topic" default="/inject/joy"/>
  <include file="$(find-pkg-share inject2026A)/launch/inject.launch.py">
    <arg name="auto_restart" value="$(var auto_restart)"/>
    <arg name="inject_pid" value="$(var inject_pid)"/>
    <arg name="rack_angle_profile" value="$(var rack_angle_profile)"/>
    <arg name="rack_target_angle_4_deg" value="$(var rack_target_angle_4_deg)"/>
    <arg name="rack_target_angle_5_deg" value="$(var rack_target_angle_5_deg)"/>
    <arg name="rack_angle_count_sign" value="$(var rack_angle_count_sign)"/>
    <arg name="serial_config" value="$(var serial_config)"/>
    <arg name="joy_topic" value="$(var joy_topic)"/>
  </include>
</launch>
