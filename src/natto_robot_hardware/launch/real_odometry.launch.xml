<launch>
  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="tf_wheel_0_base"
    args="--x 0.20 --y 0.20 --z 0.0 --roll 0.0 --pitch 0.0 --yaw 2.356194 --frame-id command/base_link --child-frame-id command/wheel_0_base_link"/>

  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="tf_wheel_1_base"
    args="--x 0.20 --y -0.20 --z 0.0 --roll 0.0 --pitch 0.0 --yaw 0.785398 --frame-id command/base_link --child-frame-id command/wheel_1_base_link"/>

  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="tf_wheel_2_base"
    args="--x -0.20 --y 0.20 --z 0.0 --roll 0.0 --pitch 0.0 --yaw -2.356194 --frame-id command/base_link --child-frame-id command/wheel_2_base_link"/>

  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="tf_wheel_3_base"
    args="--x -0.20 --y -0.20 --z 0.0 --roll 0.0 --pitch 0.0 --yaw -0.785398 --frame-id command/base_link --child-frame-id command/wheel_3_base_link"/>

  <node
    pkg="natto_wheel_odometry"
    exec="wheel_odometry"
    name="wheel_odometry"
    output="screen">
    <param from="$(find-pkg-share natto_robot_hardware)/config/real_omni_odometry.yaml"/>
  </node>
</launch>